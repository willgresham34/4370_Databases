main
    li $t0, 0
outer_loop: 
    bge $t0, $s0, Done
    li  $t1, 0

inner_loop: 
    bge $t1, $s1, iter_outer_loop

    li $t4, 10          # load 10

    add $t2, $t0, $t1
    sll $t2, $t2, 2     # multiply by 4 two account for word 4 bytes length
    add $t3, $s2, $t2
    sw $t4, 0($t3)

    addi $t1, $t1, 1
    j inner_loop

iter_outer_loop:
    addi $t0, $t0, 1
    j outer_loop

Done: li $v0, 10
Syscall