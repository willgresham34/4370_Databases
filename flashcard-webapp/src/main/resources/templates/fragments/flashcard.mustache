<div class="flashcard">
  <div class="side term">
    {{term}}
  </div>
  <div class="divider"></div>
  <div class="side desc">
    {{cardDesc}}
  </div>
  {{#owner}}
    <div class="divider"></div>
    <button 
      class="edit-card-btn" 
      data-card-id="{{cardId}}" 
      data-card-term="{{term}}" 
      data-card-desc="{{cardDesc}}" 
      data-set-id="{{setId}}"
      onclick="openUpdateCardModal(this)"
      aria-label="Edit card"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="12" cy="5" r="2"/>
        <circle cx="12" cy="12" r="2"/>
        <circle cx="12" cy="19" r="2"/>
      </svg>
    </button>
  {{/owner}}
  
</div>
