{{< base}}
  {{$title}}Set Details{{/title}}

  {{$body}}
  {{> fragments/error_message}}
    <div class="set-details-header">
        <div class="set-preview">
          <div class="set-prev-header">
          
            <h2 class="set-title">{{name}}</h2>
            <div class="set-sub-title">
              <div class="split">
                  <span class="set-author">By: <a href="/profile/viewUser?userId={{userId}}">{{fullName}}</a></span>
                  {{#auth}}
                    <button class="btn" onclick="openAddToFolderModal()" style="margin: 0rem 1rem">Add to Folder</button>
                  {{/auth}}
              </div>
              <div class="split">
                  <span class="set-category">{{category}}</span>
              </div>
            </div>     
          </div>
          <div class="set-prev-body">
            <p class="set-description">{{description}}</p>
          </div>
        </div>
    </div>
    <div class="fc-container">
        <div>
                {{#flashcards}}
                        {{> fragments/flashcard }}
                {{/flashcards}}
                {{#owner}}
                  <div class="flashcard">
                      <button type="button" class="add-card-btn" onclick="openCreateCardModal()">+</button>
                  </div>
                {{/owner}}
        </div>  
    <div>

<div id="createCardModal" class="modal-overlay" style="display:none">
    <div class="modal">
      <button class="modal-close" onclick="closeCreateCardModal()">&times;</button>
      <h2>Create New Card</h2>

      <form action="/create-card" method="post" class="card-form">
        <input type="hidden" name="setId" value="{{setId}}" />

        <div class="form-group">
          <label for="term">Term</label>
          <textarea id="term" name="term" required class="locked-width"></textarea>
        </div>

        <div class="form-group">
          <label for="cardDesc">Description</label>
          <textarea id="cardDesc" name="cardDesc" required class="locked-width" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Create Card</button>
      </form>
    </div>
</div>

<div id="updateCardModal" class="modal-overlay" style="display:none">
  <div class="modal">
    <button class="modal-close" onclick="closeUpdateCardModal()">&times;</button>
    <h2>Update or Delete Card</h2>

    <!-- Update form -->
    <form id="updateCardForm" action="/update-card" method="post" class="card-form">
      <input type="hidden" name="cardId" value="" />
      <input type="hidden" name="setId" value="" />

      <div class="form-group">
        <label for="editTerm">Term</label>
        <textarea id="editTerm" name="term" required class="locked-width"></textarea>
      </div>

      <div class="form-group">
        <label for="editDesc">Description</label>
        <textarea id="editDesc" name="cardDesc" required class="locked-width" rows="4"></textarea>
      </div>

      <div class="modal-buttons">
        <button type="button" class="btn btn-secondary" onclick="closeUpdateCardModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Update</button>
      </div>
    </form>

    <!-- Delete form -->
    <form id="deleteCardForm" action="/delete-card" method="post" style="margin-top:1rem;" class="delete-form">
      <input type="hidden" name="cardId" value="" />
      <input type="hidden" name="setId" value="" />
      <button type="submit" class="btn btn-danger">Delete</button>
    </form>
  </div>
</div>


<div id="addToFolderModal" class="modal-overlay">
  <div class="modal">
    <h2>Add Set to Folder</h2>
    <form id="addToFolderForm" action="/add-to-folder" method="post">
      <input type="hidden" name="setId" value="{{setId}}" />
      <div class="folder-list">
        {{#folders}}
          <label class="folder-item">
            <input type="radio" name="folderId" value="{{folderId}}" required>
            <span>{{folderName}}</span>
          </label>
        {{/folders}}
        {{^folders}}
          <p style="padding:0.5rem;">No folders available.</p>
        {{/folders}}
      </div>
      <div class="modal-buttons">
        <button type="button" class="btn-cancel" onclick="closeAddToFolderModal()">Cancel</button>
        <button type="submit" class="btn-add">Add</button>
      </div>
    </form>
  </div>
</div>

  <script>
    function openCreateCardModal(){
      document.getElementById('createCardModal').style.display = 'flex';
    }
    function closeCreateCardModal(){
      document.getElementById('createCardModal').style.display = 'none';
    }

    function openAddToFolderModal() {
      document.getElementById('addToFolderModal').style.display = 'flex';
    }
    function closeAddToFolderModal() {
      document.getElementById('addToFolderModal').style.display = 'none';
    }

    function openUpdateCardModal(triggerElem) {
    const id = triggerElem.dataset.cardId;
    const term = triggerElem.dataset.cardTerm;
    const desc = triggerElem.dataset.cardDesc;
    const setId = triggerElem.dataset.setId;

    document.getElementById('editTerm').value = term;
    document.getElementById('editDesc').value = desc;

    const updateForm = document.getElementById('updateCardForm');
    updateForm.elements['cardId'].value = id;
    updateForm.elements['setId'].value = setId;

    const deleteForm = document.getElementById('deleteCardForm');
    deleteForm.elements['cardId'].value = id;
    deleteForm.elements['setId'].value = setId;

    document.getElementById('updateCardModal').style.display = 'flex';
  }

  function closeUpdateCardModal() {
    document.getElementById('updateCardModal').style.display = 'none';
  }
  </script>
  {{/body}}
{{/base}}